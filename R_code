server <- function(input, output, session) {

  fmt_dollar <- function(x) {
    paste0("$", format(round(x, 2), big.mark = ",", nsmall = 2))
  }

  fmt_pct <- function(x) {
    paste0(round(x * 100, 2), "%")
  }

  calc_results <- reactive({

    n_input <- input$years
    starting_salary <- input$salary
    wage_growth <- input$wage_growth
    employee_rate <- input$employee_rate
    employer_rate <- input$employer_rate
    employee_income_tax_rate <- input$employee_income_tax_rate
    employer_tax_rate <- input$employer_tax_rate
    earnings_tax_rate <- input$earnings_tax_rate
    gross_return <- input$gross_return
    discount_rate <- input$discount_rate

    # Allow fractional years without creating artificial jumps.
    # For example, 32.9 years is modelled as 32 full years plus 0.9 of a final year.
    full_years <- floor(n_input)
    partial_year <- n_input - full_years

    period_lengths <- rep(1, full_years)
    if (partial_year > 1e-8) {
      period_lengths <- c(period_lengths, partial_year)
    }

    n_periods <- length(period_lengths)
    period_start <- cumsum(c(0, head(period_lengths, -1)))
    period_end <- cumsum(period_lengths)

    salary_t <- numeric(n_periods)
    gross_member_contrib <- numeric(n_periods)
    gross_employer_contrib <- numeric(n_periods)
    member_income_tax_tte <- numeric(n_periods)
    employer_tax_tte <- numeric(n_periods)
    contribution_tax_tte <- numeric(n_periods)
    total_contrib_tte <- numeric(n_periods)
    total_contrib_eet <- numeric(n_periods)
    opening_tte <- numeric(n_periods)
    opening_eet <- numeric(n_periods)
    gross_earnings_tte <- numeric(n_periods)
    earnings_tax_tte <- numeric(n_periods)
    closing_tte <- numeric(n_periods)
    gross_earnings_eet <- numeric(n_periods)
    closing_eet <- numeric(n_periods)
    total_tax_tte <- numeric(n_periods)
    tax_value_at_retirement <- numeric(n_periods)

    bal_tte <- 0
    bal_eet <- 0

    for (p in seq_len(n_periods)) {

      period_length <- period_lengths[p]

      # Salary is the annual salary applying at the start of the period.
      # Contributions are pro-rated for partial years.
      salary_t[p] <- starting_salary * ((1 + wage_growth)^period_start[p])

      gross_member_contrib[p] <- salary_t[p] * employee_rate * period_length
      gross_employer_contrib[p] <- salary_t[p] * employer_rate * period_length

      # Member contributions are paid from taxable income.
      # The tax is counted as tax paid, but it does not reduce the amount contributed.
      member_income_tax_tte[p] <- gross_member_contrib[p] * employee_income_tax_rate

      # Employer contributions are reduced by employer contribution tax in the TTE path.
      employer_tax_tte[p] <- gross_employer_contrib[p] * employer_tax_rate
      contribution_tax_tte[p] <- member_income_tax_tte[p] + employer_tax_tte[p]

      total_contrib_tte[p] <- gross_member_contrib[p] + gross_employer_contrib[p] - employer_tax_tte[p]
      total_contrib_eet[p] <- gross_member_contrib[p] + gross_employer_contrib[p]

      opening_tte[p] <- bal_tte
      opening_eet[p] <- bal_eet

      # Use an effective return for the period length rather than applying a full-year return to a partial year.
      period_return <- (1 + gross_return)^period_length - 1

      # TTE path
      avg_balance_tte <- bal_tte + 0.5 * total_contrib_tte[p]
      gross_earn_tte <- avg_balance_tte * period_return
      earn_tax_tte <- gross_earn_tte * earnings_tax_rate
      net_earn_tte <- gross_earn_tte - earn_tax_tte

      bal_tte <- bal_tte + total_contrib_tte[p] + net_earn_tte

      gross_earnings_tte[p] <- gross_earn_tte
      earnings_tax_tte[p] <- earn_tax_tte
      closing_tte[p] <- bal_tte

      # EET path
      avg_balance_eet <- bal_eet + 0.5 * total_contrib_eet[p]
      gross_earn_eet <- avg_balance_eet * period_return
      bal_eet <- bal_eet + total_contrib_eet[p] + gross_earn_eet

      gross_earnings_eet[p] <- gross_earn_eet
      closing_eet[p] <- bal_eet

      total_tax_tte[p] <- contribution_tax_tte[p] + earn_tax_tte

      # Tax is assumed to be paid at the end of each period and carried forward to retirement.
      tax_value_at_retirement[p] <- total_tax_tte[p] * ((1 + discount_rate)^(n_input - period_end[p]))
    }

    final_balance_tte <- closing_tte[n_periods]
    final_balance_eet <- closing_eet[n_periods]
    balance_increase <- final_balance_eet - final_balance_tte
    balance_increase_pct <- if (final_balance_tte > 0) balance_increase / final_balance_tte else 0
    total_tax_paid_nominal <- sum(total_tax_tte)
    total_tax_value_at_retirement <- sum(tax_value_at_retirement)

    required_tax_rate <- if (final_balance_eet > 0) {
      total_tax_value_at_retirement / final_balance_eet
    } else {
      0
    }

    after_tax_balance_eet <- final_balance_eet * (1 - required_tax_rate)

    schedule <- data.frame(
      Period = seq_len(n_periods),
      Year_End = round(period_end, 2),
      Period_Length = round(period_lengths, 2),
      Salary = round(salary_t, 2),
      Opening_Balance_TTE = round(opening_tte, 2),
      Opening_Balance_EET = round(opening_eet, 2),
      Gross_Member_Contribution = round(gross_member_contrib, 2),
      Gross_Employer_Contribution = round(gross_employer_contrib, 2),
      Member_Income_Tax_TTE = round(member_income_tax_tte, 2),
      Employer_Contribution_Tax_TTE = round(employer_tax_tte, 2),
      Contribution_Tax_TTE = round(contribution_tax_tte, 2),
      Gross_Earnings_TTE = round(gross_earnings_tte, 2),
      Earnings_Tax_TTE = round(earnings_tax_tte, 2),
      Total_TTE_Tax = round(total_tax_tte, 2),
      Closing_Balance_TTE = round(closing_tte, 2),
      Gross_Earnings_EET = round(gross_earnings_eet, 2),
      Closing_Balance_EET = round(closing_eet, 2),
      Tax_Value_At_Retirement = round(tax_value_at_retirement, 2)
    )

    list(
      years = period_end,
      tte = closing_tte,
      eet = closing_eet,
      schedule = schedule,
      final_balance_tte = final_balance_tte,
      final_balance_eet = final_balance_eet,
      balance_increase = balance_increase,
      balance_increase_pct = balance_increase_pct,
      total_tax_paid_nominal = total_tax_paid_nominal,
      total_tax_value_at_retirement = total_tax_value_at_retirement,
      required_tax_rate = required_tax_rate,
      after_tax_balance_eet = after_tax_balance_eet
    )
  })

  output$final_balance_tte <- renderText({ fmt_dollar(calc_results()$final_balance_tte) })
  output$final_balance_eet <- renderText({ fmt_dollar(calc_results()$final_balance_eet) })

  output$balance_increase <- renderText({
    paste0(fmt_dollar(calc_results()$balance_increase), " (", fmt_pct(calc_results()$balance_increase_pct), ")")
  })

  output$total_tax_paid_nominal <- renderText({ fmt_dollar(calc_results()$total_tax_paid_nominal) })
  output$tax_value_at_retirement <- renderText({ fmt_dollar(calc_results()$total_tax_value_at_retirement) })
  output$required_tax_rate <- renderText({ fmt_pct(calc_results()$required_tax_rate) })
  output$after_tax_balance_eet <- renderText({ fmt_dollar(calc_results()$after_tax_balance_eet) })

  output$schedule_table <- renderTable({
    calc_results()$schedule
  }, striped = FALSE, bordered = FALSE, spacing = "xs")

  output$balance_plot <- renderPlot({
    r <- calc_results()
    op <- par(no.readonly = TRUE)
    on.exit(par(op), add = TRUE)

    par(bg = "white", mar = c(4.2, 4.5, 2.5, 1.2))
    ylim_max <- max(c(r$tte, r$eet)) * 1.05

    plot(
      r$years, r$tte,
      type = "l",
      lwd = 3,
      col = "#2f78b7",
      xlab = "Year",
      ylab = "Balance",
      main = "",
      ylim = c(0, ylim_max),
      las = 1
    )

    lines(r$years, r$eet, lwd = 3, col = "#82c7f5")

    legend(
      "topleft",
      legend = c("TTE", "EET"),
      col = c("#2f78b7", "#82c7f5"),
      lwd = 3,
      bty = "n",
      cex = 0.95
    )
  })
}

shiny::shinyApp(ui = ui, server = server)
